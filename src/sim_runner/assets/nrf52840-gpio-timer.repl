// Fixed digital input/output and TIMER0 IRQ subset. No SVD, tags or bridges.
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
    PerformanceInMips: 100

flash: Memory.MappedMemory @ sysbus 0x0
    size: 0x100000

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

uart0: UART.NRF52840_UART @ sysbus 0x40002000
    easyDMA: false
    -> nvic@2

gpio0: GPIOPort.NRF52840_GPIO @ sysbus 0x50000500
    13 -> gpio0@14

// Renode 1.17 GPIO PinChanged requires the built-in GPIOTE subscriber.
gpio1: GPIOPort.NRF52840_GPIO @ sysbus 0x50000800

gpiote: GPIOPort.NRF52840_GPIOTasksEvents @ sysbus 0x40006000
    port0: gpio0
    port1: gpio1
    -> nvic@6

timer0: Timers.NRF52840_Timer @ sysbus 0x40008000
    numberOfEvents: 4
    -> nvic@8
