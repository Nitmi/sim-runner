// Deliberately restricted UART-only model using Renode's built-in peripherals.
// Not a full nRF52840 DK platform; no SVD downloads, tags or stub registers.
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
    PerformanceInMips: 100

flash: Memory.MappedMemory @ sysbus 0x0
    size: 0x100000

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

uart0: UART.NRF52840_UART @ sysbus 0x40002000
    easyDMA: false
    -> nvic@2
